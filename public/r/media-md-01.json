{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-md-01",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "https://wigggle-ui.vercel.app/r/widget.json",
    "https://wigggle-ui.vercel.app/r/audio-player.json",
    "https://wigggle-ui.vercel.app/r/label.json",
    "https://wigggle-ui.vercel.app/r/avatar.json",
    "https://wigggle-ui.vercel.app/r/button.json"
  ],
  "files": [
    {
      "path": "registry/default/widgets/media/md/media-01.tsx",
      "content": "import {\n  CastIcon,\n  HeartIcon,\n  ShuffleIcon,\n  SkipBackIcon,\n  SkipForwardIcon,\n} from \"lucide-react\";\n\nimport {\n  AudioPlayerButton,\n  AudioPlayerDuration,\n  AudioPlayerProgress,\n  AudioPlayerProvider,\n  AudioPlayerTime,\n} from \"@/components/ui/audio-player\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Widget,\n  WidgetFooter,\n  WidgetHeader,\n} from \"@/registry/default/ui/widget\";\n\nconst track = {\n  data: { artist: \"Jonathan Coulton\", title: \"Code Monkey\" },\n  id: \"0\",\n  src: \"/code-monkey.mp3\",\n};\n\nconst WidgetDemo = () => (\n  <AudioPlayerProvider>\n    <Widget className=\"justify-between\" size=\"md\">\n      <WidgetHeader className=\"items-center justify-between\">\n        <div className=\"flex items-center justify-center gap-x-3\">\n          <Avatar className=\"size-12\">\n            <AvatarImage\n              src=\"https://i.scdn.co/image/ab67616d0000b273dfd5b5d99cf81f1864deef01\"\n              alt=\"Code Monkey\"\n            />\n            <AvatarFallback>NU</AvatarFallback>\n          </Avatar>\n          <div>\n            <Label>{track.data.title}</Label>\n            <Label variant=\"muted-foreground\" size=\"sm\">\n              {track.data.artist}\n            </Label>\n          </div>\n        </div>\n        <Button variant=\"ghost\" size=\"icon-sm\">\n          <HeartIcon className=\"stroke-muted-foreground size-5\" />\n        </Button>\n      </WidgetHeader>\n      <WidgetFooter className=\"flex w-full flex-col gap-3\">\n        <div className=\"flex w-full flex-col gap-1.5\">\n          <AudioPlayerProgress className=\"h-full max-h-2 w-full flex-1\" />\n          <div className=\"flex w-full items-center justify-between\">\n            <AudioPlayerTime />\n            <AudioPlayerDuration />\n          </div>\n        </div>\n        <div className=\"mx-auto flex w-max items-center justify-between gap-8\">\n          <Button variant=\"ghost\" size=\"icon-sm\">\n            <ShuffleIcon className=\"stroke-muted-foreground size-5\" />\n          </Button>\n          <Button variant=\"ghost\" size=\"icon-sm\">\n            <SkipBackIcon className=\"stroke-muted-foreground size-5\" />\n          </Button>\n          <AudioPlayerButton size=\"icon-sm\" item={track} />\n          <Button variant=\"ghost\" size=\"icon-sm\">\n            <SkipForwardIcon className=\"stroke-muted-foreground size-5\" />\n          </Button>\n          <Button variant=\"ghost\" size=\"icon-sm\">\n            <CastIcon className=\"stroke-muted-foreground size-5\" />\n          </Button>\n        </div>\n      </WidgetFooter>\n    </Widget>\n  </AudioPlayerProvider>\n);\n\nexport default WidgetDemo;\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "tags": [
      "media"
    ],
    "size": "md",
    "credits": [
      {
        "name": "@elevenlabs-ui",
        "homepage": "https://ui.elevenlabs.io/docs/components/audio-player",
