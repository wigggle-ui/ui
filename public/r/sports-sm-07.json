{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sports-sm-07",
  "registryDependencies": [
    "https://wigggle-ui.vercel.app/r/widget.json",
    "https://wigggle-ui.vercel.app/r/label.json",
    "https://wigggle-ui.vercel.app/r/table.json",
    "https://wigggle-ui.vercel.app/r/utils.json"
  ],
  "files": [
    {
      "path": "registry/default/widgets/sports/sm/sports-07.tsx",
      "content": "import { cn } from \"cn\";\nimport Image from \"next/image\";\n\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\";\nimport {\n  Widget,\n  WidgetContent,\n  WidgetHeader,\n} from \"@/registry/default/ui/widget\";\n\nconst scores = [\n  {\n    five_score: 17,\n    four_score: 26,\n    one_score: 27,\n    teamAbbr: \"GSW\",\n    teamName: \"Golden State Warriors\",\n    three_score: 33,\n    two_score: 34,\n  },\n  {\n    five_score: 11,\n    four_score: 26,\n    one_score: 31,\n    teamAbbr: \"DN\",\n    teamName: \"Denver Nuggets\",\n    three_score: 24,\n    two_score: 39,\n  },\n];\n\nconst classes = {\n  cell: \"w-1 text-center\",\n  head: \"w-1 text-center\",\n};\n\nconst WidgetDemo = () => (\n  <Widget design=\"mumbai\">\n    <WidgetHeader className=\"mt-1.5\">\n      <div className=\"flex w-full justify-between\">\n        <div className=\"flex items-center gap-2\">\n          <Image\n            className=\"size-8 rounded-full\"\n            src=\"/assets/logos/gsw.png\"\n            alt=\"GSW\"\n            width={20}\n            height={20}\n          />\n          <Label size=\"xl\">131</Label>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <Label size=\"xl\">129</Label>\n          <Image\n            className=\"size-8 rounded-full\"\n            src=\"/assets/logos/dn.png\"\n            alt=\"DN\"\n            width={20}\n            height={20}\n          />\n        </div>\n      </div>\n    </WidgetHeader>\n    <WidgetContent className=\"flex-col items-center justify-end gap-2\">\n      <div className=\"[&>div[data-slot=table-container]]:no-scrollbar w-full min-w-0\">\n        <Table className=\"min-w-max\">\n          <TableHeader>\n            <TableRow>\n              <TableHead className={cn(classes.head, \"w-1 text-start\")}>\n                <span className=\"text-muted-foreground\">Team</span>\n              </TableHead>\n              <TableHead className={classes.head}>\n                <span className=\"text-muted-foreground\">1</span>\n              </TableHead>\n              <TableHead className={classes.head}>\n                <span className=\"text-muted-foreground\">2</span>\n              </TableHead>\n              <TableHead className={classes.head}>\n                <span className=\"text-muted-foreground\">3</span>\n              </TableHead>\n              <TableHead className={classes.head}>\n                <span className=\"text-muted-foreground\">4</span>\n              </TableHead>\n              <TableHead className={classes.head}>\n                <span className=\"text-muted-foreground\">5</span>\n              </TableHead>\n            </TableRow>\n          </TableHeader>\n          <TableBody>\n            {scores.map((el, i) => (\n              <TableRow key={i}>\n                <TableCell className={cn(classes.head, \"w-1 text-start\")}>\n                  {el.teamAbbr}\n                </TableCell>\n                <TableCell className={classes.cell}>{el.one_score}</TableCell>\n                <TableCell className={classes.cell}>{el.two_score}</TableCell>\n                <TableCell className={classes.cell}>{el.three_score}</TableCell>\n                <TableCell className={classes.cell}>{el.four_score}</TableCell>\n                <TableCell className={classes.cell}>{el.five_score}</TableCell>\n              </TableRow>\n            ))}\n          </TableBody>\n        </Table>\n      </div>\n    </WidgetContent>\n  </Widget>\n);\n\nexport default WidgetDemo;\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "tags": [
      "sports"
    ],
    "size": "sm"
  },
  "type": "registry:component"
}